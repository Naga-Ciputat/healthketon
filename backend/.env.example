# ==============================================================================
# HealthKaton (Naga Ciputat) - Backend Environment Configuration
# Rujukan: docs/4-technical-design.md
# ==============================================================================

# --- Server & Runtime ---
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Neon Serverless PostgreSQL (Unified Storage + pgvector) ---
# Format asyncpg: postgresql+asyncpg://<user>:<password>@<ep-hostname>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_password@ep-cool-fog-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- Tri-Engine AI Specialization ---

# 1. Google Gemini (Google AI Studio - Free Tier)
# Model: gemini-2.0-flash / gemini-3.8-flash (Long clinical context, PNPK, Lab docs)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Groq LPU Cloud
# Model: llama-3.3-70b-versatile / llama-3.1-8b-instant (Fast tool calling, alkes parsing, dispute letter drafter)
GROQ_API_KEY=your_groq_api_key_here

# 3. NVIDIA NIM Cloud
# Model: nvidia/nv-embedqa-e5-v5 (1024-dim dense vector embedding for note cloning)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
